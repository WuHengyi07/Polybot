# =============================================================================
# prediction_market_bot — example environment file
# Copy to ".env" and edit. EVERY value here is safe by default:
# the bot PAPER TRADES with MOCK data and CANNOT place a real order.
#
# IMPORTANT: put comments on their OWN line (like these). Never write a value
# with a trailing "# comment" on the same line — some .env loaders keep the
# comment as part of the value (it broke the Open-Meteo + webhook URLs once).
# Each line below is a bare KEY=value on purpose.
# =============================================================================

# ----- Mode -----------------------------------------------------------------
# DATA_SOURCE: where market + weather data come from.
#   mock       = fully offline, deterministic (default, recommended to start)
#   live       = real Kalshi public market data + real Open-Meteo ensembles (read-only)
#   polymarket = read-only Polymarket international daily-temperature markets (paper)
# For Polymarket, set DATA_SOURCE=polymarket and list intl cities in WEATHER_CITIES
# (e.g. SHA,HKG,SEL,TPE,PAR,LON). Live on-chain trading is NOT built — paper only.
DATA_SOURCE=mock

# ----- Bankroll & strategy thresholds ---------------------------------------
STARTING_BANKROLL=100
ENTRY_EDGE_THRESHOLD=0.10
EXIT_EDGE_THRESHOLD=0.03
# Edges bigger than this are treated as model error, not opportunity.
MAX_PLAUSIBLE_EDGE=0.35
# Kalshi taker fee coefficient: fee = FEE_RATE * p * (1 - p).
FEE_RATE=0.07
# Extra edge (per contract, $) required to cover slippage.
SLIPPAGE_BUFFER=0.01
# Widen ensemble std to counter under-dispersion (>= 1.0).
SPREAD_INFLATION=1.15

# ----- NGR/EMOS spread calibration (data-driven; replaces SPREAD_INFLATION when on) --
# Learns mu'=a+b*mean, sigma^2=c+d*spread^2 from settled outcomes (minimizes CRPS).
USE_NGR=false
# Min (forecast,observed) settlements before NGR is fitted.
NGR_MIN_PAIRS=80

# ----- Settlement window (NWS "official high" uses LOCAL STANDARD TIME) ------
# civil = group the forecast by local clock time (default, unchanged).
# lst   = use the standard-time 24h window. VERIFY per city vs settled outcomes
#         (run marketbacktest) before trusting it — a wrong window biases everything.
SETTLEMENT_WINDOW=civil

# ----- Maker orders (cut fees ~4x; off by default) --------------------------
# Rest limit orders on the bid side instead of taking the ask.
USE_MAKER_ORDERS=false
# Maker fee coefficient (~1/4 of taker).
MAKER_FEE_RATE=0.0175
# Price one tick better than the best bid.
MAKER_TICK=0.01
# (paper) fraction of resting maker orders that get filled.
MAKER_FILL_PROB=0.5

# ----- Position sizing & risk limits ----------------------------------------
# Fraction of bankroll risked per trade (2%-5% band).
MAX_RISK_PER_TRADE=0.03
# Halt trading after losing this fraction of bankroll in a day.
MAX_DAILY_LOSS=0.05
# Kill switch: halt if equity falls this far below peak.
MAX_DRAWDOWN=0.20
MAX_OPEN_POSITIONS=5
# Max fraction of bankroll in any single market.
MAX_MARKET_EXPOSURE=0.10
# Max fraction of bankroll in any single category (e.g. weather).
MAX_CATEGORY_EXPOSURE=0.50
# Max fraction of bankroll deployed across all positions.
MAX_TOTAL_EXPOSURE=0.60

# ----- Trade-quality gates --------------------------------------------------
# Skip markets whose yes spread exceeds this ($).
MAX_SPREAD=0.08
# Skip markets thinner than this.
MIN_VOLUME=100
# Skip when the model's confidence score is below this.
MIN_MODEL_CONFIDENCE=0.60
# If false, skip markets within MIN_HOURS_TO_CLOSE of close.
ALLOW_NEAR_SETTLEMENT=false
MIN_HOURS_TO_CLOSE=2
# Don't BUY below this executable price (avoid 1-5c lottery tickets).
MIN_PRICE=0.05
# Don't BUY above this executable price (avoid near-certain favorites).
MAX_PRICE=0.95
# (live only) condition same-day highs on live METAR observations.
USE_INTRADAY=false
# floor = clamp members up to the observed high (default).
# bayesian = also decay forecast upside after the daily peak.
INTRADAY_MODE=floor
# Local hour of the typical daily high.
INTRADAY_PEAK_HOUR=15
# Hours after the peak for further-rise headroom to vanish.
INTRADAY_PEAK_DECAY_HOURS=4
# Don't trade cities whose model has lost to the market.
SKIP_UNPROFITABLE_SEGMENTS=false
# Min settled trades before a segment can be pruned.
SEGMENT_MIN_SAMPLES=20

# ----- Favorite-longshot selection (raise win rate + EV the legitimate way) --
# Take more high-confidence favorites the model thinks are UNDERPRICED, at a lower
# edge bar, without lowering the bar for coin-flips. OFF by default.
FAVORITE_MODE=false
# A "favorite" is a side the model gives >= this probability.
FAVORITE_P_FLOOR=0.65
# Lower edge bar applied only to underpriced favorites.
ENTRY_EDGE_THRESHOLD_FAVORITE=0.08
# Cheap contracts must clear this net-edge/price ratio (0 = off).
MIN_EDGE_TO_PRICE_RATIO=0.0

# ----- Fractional Kelly (RESEARCH ONLY — off by default) --------------------
# If true, size with fractional Kelly (still capped by MAX_RISK_PER_TRADE).
USE_KELLY_SIZING=false
KELLY_FRACTION=0.25
# Hard cap on the Kelly fraction (anti-blowup).
KELLY_FRACTION_CAP=0.5
# Scale the bet down by the model's confidence.
KELLY_CONFIDENCE_SCALED=true

# ----- Live trading safety (ALL must be deliberately enabled) ---------------
# Paper engine simulates fills; true by default.
PAPER_TRADING=true
# MASTER SWITCH for real orders. Keep false unless you mean it.
LIVE_TRADING=false
# Allow fully automated live execution (requires LIVE_TRADING=true).
AUTO_TRADE=false
# Prompt y/N before every real order.
CONFIRM_LIVE_TRADES=true
# Never send market orders unless explicitly disabled.
USE_LIMIT_ORDERS_ONLY=true
# Set true (or create the EMERGENCY_STOP file) to halt all trading instantly.
EMERGENCY_STOP=false

# ----- Polymarket API (read-only data for paper trading; no wallet/keys) -----
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com

# ----- Kalshi API (only used when DATA_SOURCE=live or LIVE_TRADING=true) -----
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# The two below are ONLY needed for live trading (orders/portfolio), NOT read-only data.
# KALSHI_PRIVATE_KEY_PATH is the path to your RSA private key .pem file.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# ----- Edge-proven gate (programmatic precondition for ANY live order) ------
# Even with the live flags + keys set, real orders are refused until the PAPER
# track record clears this bar ("prove the edge before risking money").
# Settled paper trades required:
EDGE_PROVEN_MIN_TRADES=150
# Model Brier must beat the market's Brier:
EDGE_PROVEN_REQUIRE_BRIER_BEAT=true

# ----- Markets to scan ------------------------------------------------------
# Comma-separated city codes (see src/market_parser.py CITY_REGISTRY).
# International codes (SHA,SEL,HKG,TPE,CAN,PUS,TYO,PAR,LON,SIN,...) trade on Polymarket;
# with DATA_SOURCE=live (Kalshi) they are forecast-validation only (use histbacktest).
WEATHER_CITIES=NYC,CHI
# Weather models to pool (GFS + ECMWF ~= 82 members); more models = better skill.
OPENMETEO_MODELS=gfs025,ecmwf_ifs025
# Deterministic model for histbacktest's archived forecast (a REAL forecast, not best_match).
HISTBACKTEST_FORECAST_MODEL=gfs_seamless

# ----- NBM/NWS blend (better mean from api.weather.gov; live only, off by default) ----
# Folds the NWS National Blend of Models point Tmax into the ensemble mean. That endpoint
# serves only CURRENT forecasts (no history), so it's validated only by the live forward-test.
USE_NBM_BLEND=false
# 0 = ensemble only, 1 = NWS only, 0.5 = average the two means.
NBM_BLEND_WEIGHT=0.5

# ----- Engine loop ----------------------------------------------------------
# Seconds between cycles in `python main.py run` / `service`.
LOOP_INTERVAL_SECONDS=300
DB_PATH=prediction_market_bot.db
LOG_LEVEL=INFO
# (optional) Discord/Slack webhook for unattended alerts + daily summary. Leave blank for none.
ALERT_WEBHOOK_URL=
# Which notification categories to push to ALERT_WEBHOOK_URL.
# Subset of: fills,summary,settlement,errors  (unset = all four)
NOTIFY_EVENTS=fills,summary,settlement,errors
# Streamlit dashboard auto-reload interval (seconds). 0 disables auto-reload.
DASHBOARD_REFRESH_SECONDS=5

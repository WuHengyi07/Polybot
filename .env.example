# =============================================================================
# prediction_market_bot — example environment file
# Copy to ".env" and edit. EVERY value here is safe by default:
# the bot PAPER TRADES with MOCK data and CANNOT place a real order.
# =============================================================================

# ----- Mode -----------------------------------------------------------------
# DATA_SOURCE: where market + weather data come from.
#   mock = fully offline, deterministic (default, recommended to start)
#   live = real Kalshi public market data + real Open-Meteo ensembles (READ-ONLY)
#   polymarket = read-only Polymarket international daily-temperature markets (paper only)
DATA_SOURCE=mock
# For Polymarket paper trading, set DATA_SOURCE=polymarket and list international cities, e.g.
#   WEATHER_CITIES=SHA,HKG,SEL,TPE,PAR,LON  (read-only; live on-chain trading is NOT built)

# ----- Bankroll & strategy thresholds ---------------------------------------
STARTING_BANKROLL=100
ENTRY_EDGE_THRESHOLD=0.10
EXIT_EDGE_THRESHOLD=0.03
MAX_PLAUSIBLE_EDGE=0.35       # edges bigger than this are treated as model error, not opportunity
FEE_RATE=0.07                 # Kalshi taker fee coefficient: fee = FEE_RATE*p*(1-p)
SLIPPAGE_BUFFER=0.01          # extra edge required to cover slippage (per contract, $)
SPREAD_INFLATION=1.15         # widen ensemble std to counter under-dispersion (>=1.0)

# ----- NGR/EMOS spread calibration (data-driven; replaces SPREAD_INFLATION when on) --
# Learns mu'=a+b*mean, sigma^2=c+d*spread^2 from settled outcomes (minimizes CRPS).
USE_NGR=false                 # use the fitted NGR distribution when available
NGR_MIN_PAIRS=80              # min (forecast,observed) settlements before NGR is fitted

# ----- Settlement window (NWS 'official high' uses LOCAL STANDARD TIME) ------
# 'civil' = group the forecast by local clock time (default, unchanged).
# 'lst'   = use the standard-time 24h window. VERIFY per city vs settled outcomes first
#           (run `marketbacktest` with each) before trusting it — a wrong window biases everything.
SETTLEMENT_WINDOW=civil

# ----- Maker orders (cut fees ~4x; off by default) --------------------------
USE_MAKER_ORDERS=false        # rest limit orders on the bid side instead of taking the ask
MAKER_FEE_RATE=0.0175         # maker fee coefficient (~1/4 of taker)
MAKER_TICK=0.01               # price one tick better than the best bid
MAKER_FILL_PROB=0.5           # (paper) fraction of resting maker orders that get filled

# ----- Position sizing & risk limits ----------------------------------------
MAX_RISK_PER_TRADE=0.03       # fraction of bankroll risked per trade (2%-5% band)
MAX_DAILY_LOSS=0.05           # halt trading after losing this fraction of bankroll in a day
MAX_DRAWDOWN=0.20             # kill switch: halt if equity falls this far below peak
MAX_OPEN_POSITIONS=5
MAX_MARKET_EXPOSURE=0.10      # max fraction of bankroll in any single market
MAX_CATEGORY_EXPOSURE=0.50    # max fraction of bankroll in any single category (e.g. weather)
MAX_TOTAL_EXPOSURE=0.60       # max fraction of bankroll deployed across all positions

# ----- Trade-quality gates --------------------------------------------------
MAX_SPREAD=0.08               # skip markets whose yes spread exceeds this ($)
MIN_VOLUME=100                # skip markets thinner than this (contracts)
MIN_MODEL_CONFIDENCE=0.60     # skip when the model's confidence score is below this
ALLOW_NEAR_SETTLEMENT=false   # if false, skip markets within MIN_HOURS_TO_CLOSE of close
MIN_HOURS_TO_CLOSE=2
MIN_PRICE=0.05                # don't BUY below this executable price (avoid 1-5c lottery tickets)
MAX_PRICE=0.95                # don't BUY above this executable price (avoid near-certain favorites)
USE_INTRADAY=false            # (live only) condition same-day highs on live METAR observations
INTRADAY_MODE=floor           # 'floor' = clamp members up to the observed high (default)
                              # 'bayesian' = also decay forecast upside after the daily peak
INTRADAY_PEAK_HOUR=15         # local hour of the typical daily high
INTRADAY_PEAK_DECAY_HOURS=4   # hours after the peak for further-rise headroom to vanish
SKIP_UNPROFITABLE_SEGMENTS=false  # don't trade cities whose model has lost to the market
SEGMENT_MIN_SAMPLES=20        # min settled trades before a segment can be pruned

# ----- Favorite-longshot selection (raise win rate + EV the legitimate way) --
# Takes more high-confidence favorites the model thinks are UNDERPRICED, at a lower
# edge bar — without lowering the bar for coin-flips. OFF by default.
FAVORITE_MODE=false
FAVORITE_P_FLOOR=0.65             # a "favorite" is a side the model gives >= this probability
ENTRY_EDGE_THRESHOLD_FAVORITE=0.08  # lower edge bar applied only to underpriced favorites
MIN_EDGE_TO_PRICE_RATIO=0.0       # cheap contracts must clear this net-edge/price ratio (0=off)

# ----- Fractional Kelly (RESEARCH ONLY — off by default) --------------------
USE_KELLY_SIZING=false        # if true, size with fractional Kelly (still capped by MAX_RISK_PER_TRADE)
KELLY_FRACTION=0.25
KELLY_FRACTION_CAP=0.5        # hard cap on the Kelly fraction (anti-blowup)
KELLY_CONFIDENCE_SCALED=true  # scale the bet down by the model's confidence

# ----- Live trading safety (ALL must be deliberately enabled) ---------------
PAPER_TRADING=true            # paper engine simulates fills; true by default
LIVE_TRADING=false            # MASTER SWITCH for real orders. Keep false unless you mean it.
AUTO_TRADE=false              # allow fully automated live execution (requires LIVE_TRADING=true)
CONFIRM_LIVE_TRADES=true      # prompt y/N before every real order
USE_LIMIT_ORDERS_ONLY=true    # never send market orders unless explicitly disabled
EMERGENCY_STOP=false          # set true (or create the STOP file) to halt all trading instantly

# ----- Kalshi API (only used when DATA_SOURCE=live or LIVE_TRADING=true) -----
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# The two below are ONLY needed for live trading (orders/portfolio), NOT for read-only data:
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=      # path to your RSA private key .pem file

# ----- Edge-proven gate (programmatic precondition for ANY live order) ------
# Even with the live flags + keys set, real orders are refused until the PAPER
# track record clears this bar. This is the "prove the edge before risking money" lock.
EDGE_PROVEN_MIN_TRADES=150            # settled paper trades required
EDGE_PROVEN_REQUIRE_BRIER_BEAT=true   # model Brier must beat the market's Brier

# ----- Markets to scan ------------------------------------------------------
WEATHER_CITIES=NYC,CHI        # comma-separated city codes (see src/market_parser.py CITY_REGISTRY)
# International codes (SHA,SEL,HKG,TPE,CAN,PUS,TYO,PAR,LON,SIN,...) are FORECAST-VALIDATION
# ONLY: usable with `histbacktest` to score forecast skill, but NOT live-tradeable here
# (those cities trade on Polymarket, not Kalshi; no Kalshi series / NWS settlement).
OPENMETEO_MODELS=gfs025,ecmwf_ifs025   # weather models to pool (GFS+ECMWF ~82 members); more = better skill

# ----- NBM/NWS blend (better mean from api.weather.gov; live only, off by default) ----
# Folds the NWS National Blend of Models point Tmax into the ensemble mean. The endpoint
# serves only CURRENT forecasts (no history), so this is validated only by the live
# forward-test — NOT by marketbacktest/histbacktest.
USE_NBM_BLEND=false
NBM_BLEND_WEIGHT=0.5          # 0=ensemble only, 1=NWS only; 0.5 = average the two means

# ----- Engine loop ----------------------------------------------------------
LOOP_INTERVAL_SECONDS=300     # seconds between cycles in `python main.py run` / `service`
DB_PATH=prediction_market_bot.db
LOG_LEVEL=INFO
ALERT_WEBHOOK_URL=            # (optional) Discord/Slack webhook for unattended alerts + daily summary
